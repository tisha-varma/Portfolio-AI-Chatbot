# ---------------------------------------------------------------------------
# Portfolio AI Chatbot - environment variables
#
# Copy this file to .env in the project root and fill in real values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Never commit .env. It is listed in .gitignore.
# ---------------------------------------------------------------------------

# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Required. Exact model id served by Groq; kept out of the source code on purpose.
# Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of frontend origins allowed to call the backend.
# Used by the FastAPI CORS middleware in a later phase.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum number of characters accepted for a pasted job description.
MAX_JD_CHARS=8000

# Maximum number of characters accepted for a single chat message.
MAX_MESSAGE_CHARS=1500

# Public email shown to visitors when the bot cannot answer.
# This is the only contact detail the bot is allowed to share.
CONTACT_EMAIL=varmatisha0@gmail.com
# Name used inside the system prompt. Defaults to "Tisha" when omitted.
OWNER_NAME=Tisha

# development or production.
# In production the prompt builder refuses to start if core.json still
# contains PLACEHOLDER: values, and rejects an empty projects/skills section.
ENVIRONMENT=development
