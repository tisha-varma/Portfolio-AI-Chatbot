# ---------------------------------------------------------------------------
# Portfolio AI Chatbot - environment variables
#
# Copy this file to .env in the project root and fill in real values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Never commit .env. It is listed in .gitignore. Only the project-root .env
# is loaded; real environment variables override it.
# ---------------------------------------------------------------------------

# --- Groq credentials and models -------------------------------------------
# Required: one or more Groq API keys, comma-separated.
# Create keys at https://console.groq.com/keys.
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxx

# Legacy fallback: a single key (or comma-separated keys) is still accepted
# when GROQ_API_KEYS is absent.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Required: primary model id served by Groq. Never hardcoded in source.
# Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: fallback model ids, tried in order if the primary fails before
# the first streamed token. Comma-separated; empty means no fallbacks.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# --- Generation limits ------------------------------------------------------
# Sampling temperature, between 0 and 2.
TEMPERATURE=0.2

# Maximum generated tokens for a chat reply and for a JD fit assessment.
MAX_OUTPUT_TOKENS_CHAT=600
MAX_OUTPUT_TOKENS_FIT=1400

# --- Request limits ---------------------------------------------------------
# Maximum characters in one chat message.
MAX_MESSAGE_CHARS=1500

# Conversation history sent with each request.
MAX_HISTORY_MESSAGES=8
MAX_HISTORY_CHARS=6000

# Maximum pasted job description length and uploaded file size in bytes.
MAX_JD_CHARS=8000
MAX_UPLOAD_BYTES=2000000

# --- Abuse protection -------------------------------------------------------
# Rate limits are per client IP unless TRUSTED_PROXY is enabled.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_FIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY_PER_IP=60
GLOBAL_DAILY_REQUEST_CAP=400
MAX_CONCURRENT_LLM_CALLS=4

# --- Runtime ----------------------------------------------------------------
# development or production. Production refuses placeholder knowledge.
ENVIRONMENT=development

# Trust X-Forwarded-For from the reverse proxy (Render sets this).
TRUSTED_PROXY=false

# Return 503 for every request while maintenance is in progress.
MAINTENANCE_MODE=false

# Knowledge base directory, relative to the project root or absolute.
KNOWLEDGE_DIR=backend/knowledge

# Serve the static frontend from the same FastAPI app.
SERVE_FRONTEND=true

# Public origin used for social preview tags. Empty disables them.
PUBLIC_URL=

# Comma-separated frontend origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Public email shown to visitors when the bot cannot answer. Required.
# This is the only contact detail the bot is allowed to share.
CONTACT_EMAIL=varmatisha0@gmail.com

# Name used inside the system prompt. Defaults to "Tisha" when omitted.
OWNER_NAME=Tisha
